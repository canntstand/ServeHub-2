{
  "uid": "servehub-backup-status",
  "title": "Backup Status",
  "tags": [
    "servehub",
    "backup"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Полный цикл резервирования",
      "datasource": "Prometheus",
      "description": "Текущее состояние последнего запуска. Workload — домашний сервер; Edge — VPS.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "label_replace(servehub_backup_pipeline_last_run_success{job=\"node-exporter-local\"}, \"server\", \"Workload\", \"instance\", \".*\") or label_replace(servehub_backup_pipeline_last_run_success{job=\"node-exporter-vps\"}, \"server\", \"Edge\", \"instance\", \".*\")",
          "legendFormat": "{{server}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ОШИБКА",
                  "color": "red"
                },
                "1": {
                  "text": "УСПЕШНО",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
