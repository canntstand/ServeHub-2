          "expr": "label_replace(servehub_backup_pipeline_last_run_success{job=\"node-exporter-local\"}, \"server\", \"Workload\", \"instance\", \".*\") or label_replace(servehub_backup_pipeline_last_run_success{job=\"node-exporter-vps\"}, \"server\", \"Edge\", \"instance\", \".*\")",
