global:
  scrape_interval: 2m
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["10.8.0.1:9093"]

scrape_configs:
  - job_name: blackbox-exporter
    static_configs:
      - targets: ["127.0.0.1:9115"]

  - job_name: blackbox-http
    scrape_interval: 5m
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["http://10.8.0.2:8080/health-check"]
        labels:
          check_name: "Local server health endpoint"
      - targets: ["http://10.8.0.1:9100/metrics"]
        labels:
          check_name: "VPS node exporter"
      - targets: ["https://{{ server_name }}/"]
        labels:
          check_name: "Homepage"
      - targets: ["https://grafana.{{ server_name }}/api/health"]
        labels:
          check_name: "Grafana"
      - targets: ["https://prometheus.{{ server_name }}/-/ready"]
        labels:
          check_name: "Prometheus"
      - targets: ["https://alertmanager.{{ server_name }}/-/ready"]
        labels:
          check_name: "Alertmanager"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  - job_name: blackbox-tls
    scrape_interval: 1h
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["https://grafana.{{ server_name }}/"]
        labels:
          check_name: "Wildcard TLS certificate"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  - job_name: node-exporter-local
    static_configs:
      - targets: ["10.8.0.2:9100"]

  - job_name: node-exporter-vps
    static_configs:
      - targets: ["10.8.0.1:9100"]

  - job_name: cadvisor-local
    static_configs:
      - targets: ["10.8.0.2:8090"]

  - job_name: cadvisor-vps
    static_configs:
      - targets: ["10.8.0.1:8090"]

  - job_name: nginx-exporter-local
    static_configs:
      - targets: ["10.8.0.2:9113"]

  - job_name: adguardhome-exporter
    static_configs:
      - targets: ["10.8.0.1:9618"]

  - job_name: prometheus
    static_configs:
      - targets: ["10.8.0.1:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["10.8.0.1:9093"]

  - job_name: grafana
    static_configs:
      - targets: ["10.8.0.1:3000"]

  - job_name: loki
    static_configs:
      - targets: ["10.8.0.1:3100"]

  - job_name: wg-easy
    metrics_path: /metrics/prometheus
    static_configs:
      - targets: ["10.8.0.1:51821"]
