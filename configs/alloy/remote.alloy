discovery.docker "local_containers" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "2m"
}

discovery.relabel "docker_logs_relabel" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "docker_logs" {
  host    = "tcp://docker-socket-proxy:2375"
  targets = discovery.docker.local_containers.targets

  labels = {
    "server"   = "remote-ubuntu",
    "instance" = "remote-ubuntu",
  }

  relabel_rules = discovery.relabel.docker_logs_relabel.rules

  forward_to = [loki.write.loki_storage.receiver]
}

loki.write "loki_storage" {
  endpoint {
    url        = "http://loki:3100/loki/api/v1/push"
    batch_wait = "10s"
    batch_size = "1MiB"
  }
}