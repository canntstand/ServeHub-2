FROM alpine:3.24.2

ARG AWG_TOOLS_VERSION=v3.1.20260812

RUN apk add --no-cache \
        iproute2 \
        iptables \
        bash \
        openresolv \
        dumb-init \
    && apk add --no-cache --virtual .build-deps \
        git \
        build-base \
        linux-headers \
    && git clone \
        --depth 1 \
        --branch "${AWG_TOOLS_VERSION}" \
        https://github.com/amnezia-vpn/amneziawg-tools.git \
        /tmp/amneziawg-tools \
    && make -C /tmp/amneziawg-tools/src \
    && install -Dm0755 \
        /tmp/amneziawg-tools/src/wg \
        /usr/bin/awg \
    && install -Dm0755 \
        /tmp/amneziawg-tools/src/wg-quick/linux.bash \
        /usr/bin/awg-quick \
    && ln -s /usr/bin/awg /usr/bin/wg \
    && ln -s /usr/bin/awg-quick /usr/bin/wg-quick \
    && rm -rf /tmp/amneziawg-tools \
    && apk del .build-deps \
    && mkdir -p /etc/amnezia/amneziawg

COPY scripts/amnezia-client_init.sh /init.sh

RUN chmod 0755 /init.sh

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/init.sh"]