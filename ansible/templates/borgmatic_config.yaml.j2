source_directories:
  - "/home/{{ local_user }}/ServeHub-2/apps-data/"
  - "/home/{{ local_user }}/PersonalData/"

repositories:
  - path: /mnt/backup_storage/server_backup.borg
    label: local-backup

keep_daily: 7
keep_weekly: 4
keep_monthly: 6
compression: lz4

encryption_passphrase: {{ (borgmatic_encryption_passphrase | default(borg_passphrase | default(''))) | to_json }}

loki:
  url: http://10.8.0.1:3100/loki/api/v1/push
  labels:
    app: borgmatic
    host: __hostname
    config: __config
  send_logs: true

commands:
  - before: action
    when:
      - create
    run:
      - echo "Starting backup pipeline..."
      - cd "/home/{{ local_user }}/ServeHub-2" && docker compose -f docker-compose.local.yaml down

  - after: action
    when:
      - create
    states:
      - finish
    run:
      - cd "/home/{{ local_user }}/ServeHub-2" && docker compose -f docker-compose.local.yaml up -d
      - echo "Backup completed successfully!"

  - after: error
    run:
      - cd "/home/{{ local_user }}/ServeHub-2" && docker compose -f docker-compose.local.yaml up -d