# ==============================================================================
#                 ServeHub-2: ШАБЛОН КОНФИГУРАЦИИ SECRETS.YML
# ==============================================================================
# Скопируйте этот файл под именем secrets.yml и заполните реальными значениями:
#   cp vars/secrets.yml.example vars/secrets.yml
# Не добавляйте secrets.yml в Git. Для дополнительной защиты используйте Ansible Vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. СЕТЕВАЯ ИНФРАСТРУКТУРА И ПОЛЬЗОВАТЕЛИ
# ------------------------------------------------------------------------------
# Публичный статический IPv4-адрес внешнего арендованного VPS.
# Для Vagrant — IP соответствующей виртуальной машины.
vps_public_ip: ""

# Учётная запись для первичного SSH-подключения и развёртывания на VPS.
# Bootstrap создаст её автоматически, только если прямой root-доступ работает.
# Если root-доступ запрещён, эта учётная запись уже должна существовать и иметь sudo. Для Vagrant — vagrant.
vps_user: ""

# Пароль root на VPS. Нужен для проверки прямого root-доступа и используется
# как резервное значение для SSH/sudo-пароля, если переменные ниже не заданы.
# Если root-вход запрещён, оставьте значение пустым и обязательно задайте
# vps_ssh_password и vps_sudo_password, если они требуются для начального доступа.
vps_root_password: ""

# Необязательный пароль SSH для vps_user на этапе начального bootstrap.
# Задайте, если он отличается от root-пароля. При входе только по SSH-ключу оставьте пустым.
vps_ssh_password: ""

# Необязательный пароль sudo для vps_user на этапе начального bootstrap.
# Задайте, если он отличается от root-пароля. После bootstrap deploy_user получит NOPASSWD sudo.
vps_sudo_password: ""

# Приватный IPv4-адрес локального сервера в домашней сети.
# Для Vagrant — IP соответствующей виртуальной машины.
local_private_ip: ""

# Учётная запись для первичного SSH-подключения и развёртывания на локальном сервере.
# Если root-доступ запрещён, пользователь уже должен существовать и иметь sudo. Для Vagrant — vagrant.
local_user: ""

# Пароль root на локальном сервере; применяется аналогично vps_root_password.
local_root_password: ""

# Необязательные начальные пароли пользователя local_user, если отличаются от root-пароля.
# Если вход уже настроен только по SSH-ключу и sudo доступен без пароля, оставьте пустыми.
local_ssh_password: ""
local_sudo_password: ""

# ------------------------------------------------------------------------------
# 2. ГЛОБАЛЬНЫЕ НАСТРОЙКИ И АДМИНИСТРИРОВАНИЕ
# ------------------------------------------------------------------------------
# Основной зарегистрированный домен проекта (например, server.ru), без схемы https://.
server_name: ""

# Имя главного администратора веб-интерфейсов и сервисов.
admin_user: "admin"

# Сложный глобальный пароль администратора для сервисов.
# Рекомендуется сгенерировать случайную строку без кавычек и символов $.
admin_password: ""

# Основной email для регистрации/выпуска SSL-сертификатов Certbot.
email: ""

# ------------------------------------------------------------------------------
# 3. НАСТРОЙКИ АЛЕРТИНГА (TELEGRAM)
# ------------------------------------------------------------------------------
# Токен Telegram-бота от @BotFather.
telegram_token: ""

# ID чата Telegram. Для Alertmanager обычно это целое число; для супергруппы
# оно часто отрицательное. В YAML можно оставить числом, без кавычек.
telegram_chat_id: ""

# ------------------------------------------------------------------------------
# 4. ИНТЕГРАЦИЯ С DNS-ПРОВАЙДЕРОМ (АВТО-SSL)
# ------------------------------------------------------------------------------
# API-ключ Webnames.ru для DNS-01 проверки Certbot и выпуска wildcard-сертификата.
webnames_apikey: ""

# ------------------------------------------------------------------------------
# 5. НАСТРОЙКИ POSTGRESQL И REDIS
# ------------------------------------------------------------------------------
# Пользователь PostgreSQL. Обратите внимание: пароль PostgreSQL используется
# и внутри URL подключения; используйте hex/URL-safe значение без @, :, /, $ и пробелов.
postgres_user: "postgres_master"
postgres_password: ""

# Пароль Redis для Nextcloud; используйте длинную случайную строку.
nextcloud_redis_pass: ""

# ------------------------------------------------------------------------------
# 6. СЕКРЕТЫ И КЛЮЧИ БЕЗОПАСНОСТИ СЕРВИСОВ
# ------------------------------------------------------------------------------
# Токен/пароль административной панели Vaultwarden (/admin).
secret_vaultwarden_password: ""

# Pepper для Homebox. Можно сгенерировать командой: openssl rand -hex 32
hbox_pepper: ""

# Публичный ключ SSH, который будет установлен в authorized_keys пользователя deploy_user.
# Укажите ПОЛНУЮ строку из файла .pub, например ssh-ed25519 AAAAC3... workstation.
ssh_public_key: ""

# Для запуска через Compose приватный SSH-ключ должен быть доступен контейнеру.
# Укажите содержимое отдельного deploy-ключа в многострочном блоке ниже.
# Ограничьте права ansible/vars/secrets.yml до 0600 и не добавляйте его в Git.
ssh_private_key: ""

# ------------------------------------------------------------------------------
# 7. РЕЗЕРВНОЕ КОПИРОВАНИЕ (BORGMATIC)
# ------------------------------------------------------------------------------
# Парольная фраза шифрования Borg-архивов: минимум 20 символов, лучше уникальная.
borgmatic_encryption_passphrase: ""

# UUID отдельного диска для локального репозитория Workload (из sudo blkid).
# Если пусто, Workload использует /var/lib/servehub-backup/workload-repo.
# Репозиторий Edge по умолчанию: /var/lib/servehub-backup/edge-repo.
backup_disk_uuid: ""

# Параметры общего приватного бакета Timeweb Cloud S3.
# Оба сервера используют одну пару ключей, но разные префиксы (workload/ и edge/).
# Рекомендуется отдельный S3-пользователь с правами «Чтение и запись» только
# для servehub-2-bucket. Проверьте разрешения пользователя в панели Timeweb.
offsite_s3_endpoint: "https://s3.twcstorage.ru"
offsite_s3_region: "ru-1"
offsite_s3_bucket: ""
offsite_s3_access_key_id: ""
offsite_s3_secret_access_key: ""
offsite_s3_workload_prefix: "workload"
offsite_s3_edge_prefix: "edge"

# ------------------------------------------------------------------------------
# 8. HERMES AGENT (обязательный компонент Edge)
# ------------------------------------------------------------------------------
# OpenAI-compatible API. Значения используются для первичного заполнения данных Hermes;
# после первого запуска модель и API-ключ можно менять в Hermes Dashboard.
hermes_api_base_url: "https://api.aitunnel.ru/v1"
hermes_api_key: ""
hermes_model: "deepseek-v4-flash"
# Секрет сессий Dashboard: сгенерируйте `openssl rand -hex 32`.
hermes_dashboard_basic_auth_secret: ""

# ------------------------------------------------------------------------------
# 9. НЕОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# ------------------------------------------------------------------------------
# Не меняйте соль AdGuard после первого запуска, иначе хеш пароля может измениться.
# adguard_password_salt: "servehubadguardsalt22x"

# При необходимости можно переопределить pin версии Borgmatic (по умолчанию в playbook 2.1.10).
# borgmatic_version: "2.1.10"
