# ServeHub-2 secrets template. Copy to secrets.yml and replace the empty values.
# Never commit secrets.yml. Keep it mode 0600. The GUI expects plain YAML; Ansible Vault is not integrated.
# Prepare with: cp ansible/vars/secrets.yml.example ansible/vars/secrets.yml

# Connection and initial SSH/bootstrap access
vps_public_ip: ""
# If root SSH is disabled, vps_user must already exist and have sudo. For Vagrant, use vagrant.
vps_user: ""
# Root password; may also be used as the initial SSH/sudo password fallback.
vps_root_password: ""
# Set only if the initial SSH password differs from the root password.
vps_ssh_password: ""
# Set only if the initial sudo password differs from the root password.
vps_sudo_password: ""
# Workload private LAN IPv4 address; use the VM address in Vagrant.
local_private_ip: ""
# If root SSH is disabled, local_user must already exist and have sudo. For Vagrant, use vagrant.
local_user: ""
local_root_password: ""
local_ssh_password: ""
local_sudo_password: ""

# Domain and administrator
# Main domain without the https:// scheme.
server_name: ""
admin_user: ""
# Use a strong random password. Avoid '$' because Compose interpolates it.
admin_password: ""
email: ""

# Telegram alerting
telegram_token: ""
telegram_chat_id: ""

# Webnames DNS-01 API key for wildcard TLS certificates
webnames_apikey: ""

# PostgreSQL
postgres_user: ""
# Used in a connection URL: use URL-safe characters; avoid @, :, /, $, and spaces.
postgres_password: ""

# Internal Nextcloud Redis secret. The GUI generates 32 random bytes as hexadecimal.
# For a manual Ansible deployment, provide a unique 64-character hexadecimal value.
nextcloud_redis_pass: ""

# Application secrets
secret_vaultwarden_password: ""
# Homebox pepper; generate with: openssl rand -hex 32
hbox_pepper: ""
# Full public-key line from the dedicated deployment key's .pub file.
ssh_public_key: ""
# Contents of a dedicated private deployment SSH key, not a personal key.
ssh_private_key: ""

# Borg encryption and local repository
# Keep this passphrase (minimum 20 characters) separately from both hosts and S3.
borgmatic_encryption_passphrase: ""
# Optional UUID of the Workload backup disk (from lsblk/blkid). Empty uses the default local path.
backup_disk_uuid: ""

# S3-compatible off-site backup. Create the private bucket before deployment.
# Endpoint is the base API URL without bucket/path; region may be empty if not required.
# Use dedicated least-privilege keys; Edge and Workload prefixes must differ.
offsite_s3_endpoint: ""
offsite_s3_region: ""
offsite_s3_bucket: ""
offsite_s3_access_key_id: ""
offsite_s3_secret_access_key: ""
offsite_s3_workload_prefix: "workload"
offsite_s3_edge_prefix: "edge"

# Hermes Agent settings for Edge
# Enter the OpenAI-compatible API base URL and model.
hermes_api_base_url: ""
hermes_api_key: ""
hermes_model: ""
# Generate a 64-character hexadecimal secret with: openssl rand -hex 32
hermes_dashboard_basic_auth_secret: ""
